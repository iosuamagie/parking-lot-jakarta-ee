<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE glassfish-web-app PUBLIC "-//GlassFish.org//DTD GlassFish Application Server 3.1 Servlet 3.0//EN"
        "http://glassfish.org/dtds/glassfish-web-app_3_0-1.dtd">
<glassfish-web-app>
    <context-root>/</context-root>

    <!-- Each database group gives the role with the same name -->
    <security-role-mapping>
        <role-name>READ_CARS</role-name>
        <group-name>READ_CARS</group-name>
    </security-role-mapping>
    <security-role-mapping>
        <role-name>WRITE_CARS</role-name>
        <group-name>WRITE_CARS</group-name>
    </security-role-mapping>
    <security-role-mapping>
        <role-name>READ_USERS</role-name>
        <group-name>READ_USERS</group-name>
    </security-role-mapping>
    <security-role-mapping>
        <role-name>WRITE_USERS</role-name>
        <group-name>WRITE_USERS</group-name>
    </security-role-mapping>
    <security-role-mapping>
        <role-name>INVOICING</role-name>
        <group-name>INVOICING</group-name>
    </security-role-mapping>
</glassfish-web-app>
